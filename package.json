{
  "name": "dsh-keynav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard navigation for DSH web question, plan-review and approval panels: arrows move, space selects, enter submits.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "manifestVersion": 1
  },
  "license": "MIT"
}
